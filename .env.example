# ============================================================
# MODELO DE CONFIGURAÇÃO DE CREDENCIAIS (.env)
# ============================================================
# Instruções:
# 1. Copie este arquivo e renomeie a cópia para '.env'
# 2. Preencha seus dados de acesso reais abaixo
# 3. NUNCA suba o arquivo '.env' preenchido para o Git!
# ============================================================

# Portal ERP LF (Oracle APEX)
LF_USER=seu_usuario_aqui
LF_PASS=sua_senha_aqui

# Portal Mercado Eletrônico (WEG Joinville)
WEG_JVE_USER=seu_usuario_weg_jve
WEG_JVE_PASS=sua_senha_weg_jve

# Portal Mercado Eletrônico (WEG Distribuição / Tintas)
WEG_DI_USER=seu_usuario_weg_di
WEG_DI_PASS=sua_senha_weg_di
